# Copy to .env.local and fill in. .env.local is gitignored; this file is not.

# --- Razorpay (test mode only) ---
RAZORPAY_KEY_ID=""                 # must start with rzp_test_ ; the probe refuses anything else
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Supabase Postgres ---
# Two different strings, from Supabase -> Connect. `npm run db:check` says if they are swapped.
DATABASE_URL=""                    # pooled, port 6543. The app, the MCP server, every script.
DIRECT_URL=""                      # direct, port 5432. drizzle.config.ts only, for migrations.

# --- Signing ---
# Generated by `npm run keygen`. Ed25519, base64 PKCS8 / SPKI.
VOUCH_SIGNING_PRIVATE_KEY=""
VOUCH_SIGNING_PUBLIC_KEY=""
VOUCH_SIGNING_KEY_ID="vouch-k1"

# --- Buyer agent (never in the money path) ---
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# --- Local ---
APP_URL="http://localhost:3000"    # webhook callback target; a tunnel URL when testing webhooks
VOUCH_AGENT_KEY="vouch_sk_demo_shopbot"

# Default closed: these routes spend the seeded mandate and call a paid model.
DEMO_CONSOLE="1"

# Bearer for /api/cron/expire. Unset means that route always refuses.
CRON_SECRET=""
