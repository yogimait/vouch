# Copy to .env.local and fill in. .env.local is gitignored; this file is not.

# --- Razorpay (test mode only) ---
# Dashboard -> Account & Settings -> API Keys -> Generate Test Key
RAZORPAY_KEY_ID=""                 # must start with rzp_test_ ; the probe refuses anything else
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""         # Dashboard -> Webhooks -> the secret you set when creating it

# --- Supabase Postgres ---
# TWO different strings, from Supabase -> Connect. Getting these backwards costs an afternoon.
#
#   DATABASE_URL  <- Connect -> "ORM" tab -> Drizzle.   Host contains pooler.supabase.com, port 6543.
#   DIRECT_URL    <- Connect -> "Direct" tab.           Host is db.<ref>.supabase.co, port 5432.
#
# Run `npm run db:check` after filling these in; it prints the port and tells you if they are swapped.
#
# If migrations fail with ENETUNREACH / EHOSTUNREACH, the direct host is IPv6-only and your network
# is IPv4. Use the SESSION POOLER string instead (same page, pooler host, port 5432) for DIRECT_URL.
DATABASE_URL=""                    # POOLED, 6543. The app, the MCP server, and every script.
DIRECT_URL=""                      # DIRECT, 5432. drizzle.config.ts only, for migrations.

# --- Signing ---
# Generated by `npm run keygen`. Ed25519, base64 PKCS8 / SPKI.
VOUCH_SIGNING_PRIVATE_KEY=""
VOUCH_SIGNING_PUBLIC_KEY=""
VOUCH_SIGNING_KEY_ID="vouch-k1"

# --- Buyer agent (never in the money path) ---
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# --- Local ---
APP_URL="http://localhost:3000"    # webhook callback target; a tunnel URL when testing webhooks
